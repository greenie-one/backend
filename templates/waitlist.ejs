<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap"
            rel="stylesheet"
        />

        <title>Email Template</title>
    </head>

    <style>
        * {
            font-family: "Inter", sans-serif !important;
        }
        body {
            margin: 0;
            padding: 2rem;
            min-height: 100vh;
            display: grid;
            place-items: center;
            box-sizing: border-box;
            background-color: #229e57;
            overflow-x: hidden !important;
        }
        .template {
            max-width: 750px;
            padding: 1rem 2rem;
            background-color: #fff;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            box-shadow: 0px 0px 40px rgba(0, 0, 0, 0.25);
        }
        .tempalte_header {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo {
            font-weight: 700;
            font-size: 32px;
            line-height: 38px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .icons-list {
            width: 8.5rem;
            gap: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            list-style: none;
        }
        .icon {
            width: 1.25rem;
            height: 1.25rem;
            cursor: pointer;
        }
        .login {
            color: black;
            text-decoration: none;
            font-weight: 600;
            font-size: 21px;
            line-height: 19px;
        }

        .template_body {
            width: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        .template_content {
            width: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        .template_content h1 {
            font-weight: 800;
            font-size: 48px;
            line-height: 56px;
            color: #000;
            margin: 1rem 0 0 0;
        }
        .template_content h3 {
            font-weight: 600;
            font-size: 24px;
            line-height: 28px;
            color: #000;
            margin-top: 1rem;
        }
        .template_content p {
            width: 64%;
            text-align: center;
            font-weight: 400;
            font-size: 18px;
            line-height: 21px;
            color: gray;
            margin: 0rem 0 2rem 0;
        }
        .mascot {
            width: 100%;
            max-width: 500px;
            margin-bottom: 1rem;
        }

        /* media query for mobile */
        @media screen and (max-width: 480px) {
            body {
                padding: 1rem;
            }
            .template {
                padding: 0 1.25rem;
            }
            .template_content p {
                width: 100%;
            }
            .logo {
                font-size: 18px;
            }
            .logo img {
                width: 1.25rem;
                height: 1.25rem;
            }
            .login {
                font-size: 18px;
            }
            .icons-list {
                width: 8rem;
            }
            .icon {
                width: 1.25rem;
                height: 1.25rem;
            }
            .template_content h1 {
                font-size: 32px;
            }
            .template_content h3 {
                font-size: 22px;
                margin-top: 0;
            }
            .template_content p {
                font-size: 15px;
            }
            .mascot {
                margin-bottom: 2rem;
            }
        }

        /* media query for tablet */
        @media screen and (min-width: 481px) and (max-width: 900px) {
            .template {
                padding: 1rem 2rem;
            }
            .template_content p {
                width: 100%;
            }
            .logo {
                font-size: 28px;
            }
            .logo img {
                width: 1.6rem;
                height: 1.6rem;
            }
            .login {
                font-size: 26px;
            }
            .icons-list {
                width: 12rem;
            }
            .icon {
                width: 1.75rem;
                height: 1.75rem;
            }
            .template_content h1 {
                font-size: 40px;
            }
            .template_content h3 {
                font-size: 25px;
                margin-top: 1rem;
            }
            .template_content p {
                font-size: 18px;
                width: 80%;
            }
            .mascot {
                margin-bottom: 2rem;
            }
        }
    </style>

    <body>
        <div class="template">
            <div class="tempalte_header">
                <div class="logo">
                    Greenie <img src="<%= baseUrl%>/verified.svg" alt="logo" />
                </div>
                <ul class="icons-list">
                    <li>
                        <a
                            class="login"
                            target="_blank"
                            href="https://greenie.one/"
                            >Log in</a
                        >
                    </li>
                    <li>
                        <a
                            href="https://www.linkedin.com/company/gogreenie/"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <img
                                class="icon"
                                src="<%= baseUrl%>/linkedin.svg"
                                alt=""
                            />
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://instagram.com/greenie.one"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <img class="icon" src="<%= baseUrl%>/insta.svg" alt="" />
                        </a>
                    </li>
                </ul>
            </div>
            <div class="template_body">
                <div class="template_content">
                    <h1>Hi <%= firstName %>!</h1>
                    <h1>Thank you </h1>
                    <h3>for joining to our waitlist</h3>
                    <p>
                        We will update you on your email when Greenie is up! We
                        are excited to get you on onboard. Stay tuned!
                    </p>
                </div>
                <img
                    class="mascot"
                    src="<%= baseUrl%>/mascot.png"
                    alt="email mascot"
                />
            </div>
        </div>
    </body>
</html>
