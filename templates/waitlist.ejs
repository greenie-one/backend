<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap"
            rel="stylesheet"
        />

        <title>Email Template</title>
    </head>
    <body
        style="
            margin: 0;
            padding: 2rem;
            min-height: 100vh;
            display: grid;
            place-items: center;
            box-sizing: border-box;
            background-color: #229e57;
            overflow-x: hidden !important;
            font-family: 'Inter', sans-serif !important;
        "
    >
        <div
            class="template"
            style="
                max-width: 750px;
                padding: 1rem 2rem;
                background-color: #fff;
                border-radius: 12px;
                display: flex;
                flex-direction: column;
                align-items: center;
                box-shadow: 0px 0px 40px rgba(0, 0, 0, 0.25);
            "
        >
            <div
                class="tempalte_header"
                style="
                    width: 100%;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                "
            >
                <div
                    class="logo"
                    style="
                        font-weight: 700;
                        font-size: 32px;
                        line-height: 38px;
                        display: flex;
                        align-items: center;
                        gap: 0.5rem;
                    "
                >
                    Greenie
                    <svg
                        width="22"
                        height="22"
                        viewBox="0 0 22 22"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M7.6 21.5L5.7 18.3L2.1 17.5L2.45 13.8L0 11L2.45 8.2L2.1 4.5L5.7 3.7L7.6 0.5L11 1.95L14.4 0.5L16.3 3.7L19.9 4.5L19.55 8.2L22 11L19.55 13.8L19.9 17.5L16.3 18.3L14.4 21.5L11 20.05L7.6 21.5ZM9.95 14.55L15.6 8.9L14.2 7.45L9.95 11.7L7.8 9.6L6.4 11L9.95 14.55Z"
                            fill="#9FE870"
                        />
                    </svg>
                </div>
                <ul
                    class="icons-list"
                    style="
                        width: 8.5rem;
                        gap: 1rem;
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        list-style: none;
                    "
                >
                    <li>
                        <a
                            class="login"
                            target="_blank"
                            href="https://greenie.one/"
                            style="
                                color: black;
                                text-decoration: none;
                                font-weight: 600;
                                font-size: 21px;
                                line-height: 19px;
                            "
                            >Log in</a
                        >
                    </li>
                    <li>
                        <a
                            href="https://www.linkedin.com/company/gogreenie/"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <svg
                                width="9"
                                height="18"
                                viewBox="0 0 9 18"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                                style="
                                    width: 1.25rem;
                                    height: 1.25rem;
                                    cursor: pointer;
                                "
                            >
                                <path
                                    d="M6 6V4.2C6 3.42 6.18 3 7.44 3H9V0H6.6C3.6 0 2.4 1.98 2.4 4.2V6H0V9H2.4V18H6V9H8.64L9 6H6Z"
                                    fill="black"
                                />
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://instagram.com/greenie.one"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 18 18"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                                style="
                                    width: 1.25rem;
                                    height: 1.25rem;
                                    cursor: pointer;
                                "
                            >
                                <path
                                    d="M8.99986 4.59361C6.56138 4.59361 4.59341 6.56158 4.59341 9.00005C4.59341 11.4385 6.56138 13.4065 8.99986 13.4065C11.4383 13.4065 13.4063 11.4385 13.4063 9.00005C13.4063 6.56158 11.4383 4.59361 8.99986 4.59361ZM8.99986 11.8639C7.4229 11.8639 6.13599 10.577 6.13599 9.00005C6.13599 7.4231 7.4229 6.13619 8.99986 6.13619C10.5768 6.13619 11.8637 7.4231 11.8637 9.00005C11.8637 10.577 10.5768 11.8639 8.99986 11.8639ZM13.5868 3.38619C13.0174 3.38619 12.5577 3.84595 12.5577 4.41529C12.5577 4.98462 13.0174 5.44439 13.5868 5.44439C14.1561 5.44439 14.6159 4.98677 14.6159 4.41529C14.616 4.2801 14.5895 4.1462 14.5379 4.02127C14.4862 3.89633 14.4104 3.78282 14.3148 3.68722C14.2192 3.59163 14.1057 3.51583 13.9808 3.46418C13.8559 3.41252 13.722 3.38602 13.5868 3.38619ZM17.5893 9.00005C17.5893 7.81411 17.6001 6.63892 17.5335 5.45513C17.4669 4.08013 17.1532 2.85982 16.1477 1.85435C15.1401 0.846733 13.9219 0.535209 12.5469 0.468608C11.361 0.402006 10.1858 0.412748 9.00201 0.412748C7.81607 0.412748 6.64087 0.402006 5.45709 0.468608C4.08208 0.535209 2.86177 0.848881 1.8563 1.85435C0.848686 2.86197 0.537162 4.08013 0.470561 5.45513C0.403959 6.64107 0.414702 7.81626 0.414702 9.00005C0.414702 10.1838 0.403959 11.3612 0.470561 12.545C0.537162 13.92 0.850834 15.1403 1.8563 16.1458C2.86392 17.1534 4.08208 17.4649 5.45709 17.5315C6.64302 17.5981 7.81822 17.5874 9.00201 17.5874C10.1879 17.5874 11.3631 17.5981 12.5469 17.5315C13.9219 17.4649 15.1422 17.1512 16.1477 16.1458C17.1553 15.1381 17.4669 13.92 17.5335 12.545C17.6022 11.3612 17.5893 10.186 17.5893 9.00005ZM15.6987 14.0661C15.5419 14.4571 15.3528 14.7493 15.0499 15.0501C14.7469 15.353 14.4569 15.542 14.0659 15.6989C12.9358 16.1479 10.2524 16.0469 8.99986 16.0469C7.74732 16.0469 5.06177 16.1479 3.93169 15.701C3.54068 15.5442 3.24849 15.3551 2.94771 15.0522C2.64478 14.7493 2.45572 14.4592 2.29888 14.0682C1.85201 12.936 1.95298 10.2526 1.95298 9.00005C1.95298 7.74751 1.85201 5.06197 2.29888 3.93189C2.45572 3.54087 2.64478 3.24869 2.94771 2.9479C3.25064 2.64712 3.54068 2.45591 3.93169 2.29908C5.06177 1.8522 7.74732 1.95318 8.99986 1.95318C10.2524 1.95318 12.9379 1.8522 14.068 2.29908C14.459 2.45591 14.7512 2.64497 15.052 2.9479C15.3549 3.25083 15.544 3.54087 15.7008 3.93189C16.1477 5.06197 16.0467 7.74751 16.0467 9.00005C16.0467 10.2526 16.1477 12.936 15.6987 14.0661Z"
                                    fill="black"
                                />
                            </svg>
                        </a>
                    </li>
                </ul>
            </div>
            <div
                class="template_body"
                style="
                    width: 100%;
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                    align-items: center;
                "
            >
                <div
                    class="template_content"
                    style="
                        width: 100%;
                        display: flex;
                        flex-direction: column;
                        justify-content: center;
                        align-items: center;
                    "
                >
                    <h1
                        style="
                            font-weight: 800;
                            font-size: 48px;
                            line-height: 56px;
                            color: #000;
                            margin: 1rem 0 0 0;
                        "
                    >
                        Thank you
                    </h1>
                    <h3
                        style="
                            font-weight: 600;
                            font-size: 24px;
                            line-height: 28px;
                            color: #000;
                            margin-top: 1rem;
                        "
                    >
                        for joining to our waitlist, <%= firstName %>
                    </h3>
                    <p
                        style="
                            width: 64%;
                            text-align: center;
                            font-weight: 400;
                            font-size: 18px;
                            line-height: 21px;
                            color: gray;
                            margin: 0rem 0 2rem 0;
                        "
                    >
                        We will update you on your email when Greenie is up! We
                        are excited to get you on onboard. Stay tuned!
                    </p>
                </div>
                <img
                    class="mascot"
                    src="https://dev.greenie.one/assets/mascot.png"
                    alt="email mascot"
                    style="width: 100%; max-width: 500px; margin-bottom: 1rem"
                />
            </div>
        </div>
    </body>
</html>